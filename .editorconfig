# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psd1,psm1}]
end_of_line = crlf

[*.{cmd,bat}]
end_of_line = crlf
indent_size = 4

[*.{md,typ}]
indent_size = 2
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
